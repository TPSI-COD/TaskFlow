<div class="py-4">


<div class="mb-5">

    <h1 class="fw-bold mb-2">
        Bem-vindo ao TaskFlow
    </h1>

    <p class="lead text-muted mb-0">
        Organize suas tarefas e acompanhe seu progresso.
    </p>

</div>


<div class="row g-4">

    <!-- Nova tarefa -->

    <div class="col-md-6 col-xl-3">

        <a asp-controller="Tarefa"
           asp-action="Criar"
           class="text-decoration-none text-dark">

            <div class="home-option">

                <h5 class="mb-2">
                    Nova Tarefa
                </h5>

                <p class="text-muted small mb-0">
                    Crie uma nova tarefa e defina sua prioridade.
                </p>

            </div>

        </a>

    </div>


    <!-- Minhas tarefas -->

    <div class="col-md-6 col-xl-3">

        <a asp-controller="Tarefa"
           asp-action="Index"
           class="text-decoration-none text-dark">

            <div class="home-option">

                <h5 class="mb-2">
                    Minhas Tarefas
                </h5>

                <p class="text-muted small mb-0">
                    Consulte, edite e acompanhe suas tarefas.
                </p>

            </div>

        </a>

    </div>


    <!-- Kanban -->

    <div class="col-md-6 col-xl-3">

        <a asp-controller="Tarefa"
           asp-action="Kanban"
           class="text-decoration-none text-dark">

            <div class="home-option">

                <h5 class="mb-2">
                    Kanban
                </h5>

                <p class="text-muted small mb-0">
                    Organize suas tarefas por status.
                </p>

            </div>

        </a>

    </div>


    <!-- Dashboard -->

    <div class="col-md-6 col-xl-3">

        <a asp-controller="Tarefa"
           asp-action="Dashboard"
           class="text-decoration-none text-dark">

            <div class="home-option">

                <h5 class="mb-2">
                    Dashboard
                </h5>

                <p class="text-muted small mb-0">
                    Veja um resumo do andamento das tarefas.
                </p>

            </div>

        </a>

    </div>

</div>


<div class="mt-5">

    <h5 class="mb-3">
        Acesso rápido
    </h5>

    <div class="d-flex gap-2 flex-wrap">

        <a asp-controller="Tarefa"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Ver tarefas
        </a>

        <a asp-controller="Tarefa"
           asp-action="Kanban"
           class="btn btn-outline-secondary">
            Abrir Kanban
        </a>

        <a asp-controller="Tarefa"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Ver Dashboard
        </a>

    </div>

</div>


</div>
