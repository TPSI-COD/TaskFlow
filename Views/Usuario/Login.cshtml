@model TaskFlow.Models.LoginViewModel

<div class="row align-items-center min-vh-75">


<!-- Apresentação -->

<div class="col-lg-7 mb-5 mb-lg-0">

    <span class="text-primary fw-semibold">
        TASKFLOW
    </span>

    <h1 class="display-4 fw-bold mt-2 mb-3">
        Organize suas tarefas.
        <br />
        Acompanhe seu progresso.
    </h1>

    <p class="lead text-muted mb-4">
        Uma forma simples de organizar suas atividades,
        acompanhar o andamento das tarefas e visualizar
        seu fluxo de trabalho.
    </p>


    <div class="row g-3">

        <div class="col-md-6">

            <div class="d-flex">

                <div class="me-3 text-primary fs-4">
                    ✓
                </div>

                <div>

                    <h5 class="mb-1">
                        Gerenciamento de tarefas
                    </h5>

                    <p class="text-muted small mb-0">
                        Crie, edite e acompanhe suas tarefas.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="d-flex">

                <div class="me-3 text-primary fs-4">
                    ✓
                </div>

                <div>

                    <h5 class="mb-1">
                        Kanban
                    </h5>

                    <p class="text-muted small mb-0">
                        Organize suas tarefas visualmente.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="d-flex">

                <div class="me-3 text-primary fs-4">
                    ✓
                </div>

                <div>

                    <h5 class="mb-1">
                        Dashboard
                    </h5>

                    <p class="text-muted small mb-0">
                        Acompanhe o progresso das atividades.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="d-flex">

                <div class="me-3 text-primary fs-4">
                    ✓
                </div>

                <div>

                    <h5 class="mb-1">
                        Controle de prioridades
                    </h5>

                    <p class="text-muted small mb-0">
                        Organize tarefas por prioridade e status.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Login -->

<div class="col-lg-4 offset-lg-1">

    <div class="login-area">

        <h2 class="mb-1">
            Entrar
        </h2>

        <p class="text-muted mb-4">
            Acesse sua conta para continuar.
        </p>


        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="seu@email.com" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="Senha"
                       class="form-label">
                </label>

                <input asp-for="Senha"
                       type="password"
                       class="form-control"
                       placeholder="Digite sua senha" />

                <span asp-validation-for="Senha"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="btn btn-primary w-100">
                Entrar
            </button>

        </form>


        <div class="text-center mt-4">

            <span class="text-muted">
                Ainda não possui uma conta?
            </span>

            <a asp-controller="Usuario"
               asp-action="Cadastrar"
               class="text-decoration-none">
                Cadastre-se
            </a>

        </div>

    </div>

</div>


</div>
